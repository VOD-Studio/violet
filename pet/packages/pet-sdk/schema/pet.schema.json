      },
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": false,
        "op": "frame",
        "summary": "将姿态与呈现时钟合成为字符单元网格"
      },
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": false,
        "op": "verify_birth",
        "summary": "核验出生证书的来源签名、承诺揭示与结果重算"
      },
      {
        "errors": [],
        "mutates_state": false,
        "op": "capabilities",
        "summary": "列出当前实现的全部能力与错误分类"
      }
    ],
    "rules_version": 1
  },
  "x-op-results": {
    "act": "OutcomeResult",
    "birth": "BirthResult",
    "capabilities": "CapabilityCatalogResult",
