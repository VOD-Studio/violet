{
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "enum": [
            "feed",
            "rest",
            "play",
            "heal",
            "wait"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "进化到指定分支。永不自动发生,需要主人选择。",
          "properties": {
            "evolve": {
              "properties": {
                "branch": {
                  "$ref": "#/$defs/Branch"
                }
              },
              "required": [
                "branch"
              ],
              "type": "object"
            }
          },
          "required": [
            "evolve"
          ],
          "type": "object"
        }
      ]
    },
    "Birth": {
      "properties": {
        "genes": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "pet": {
          "$ref": "#/$defs/Pet"
        },
        "rarity": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "species": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "rarity",
        "species",
        "genes",
        "pet"
      ],
      "type": "object"
    },
    "BirthInput": {
      "properties": {
        "born_at": {
          "type": "string"
        },
        "client_seed": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "server_seed": {
          "description": "服务端承诺并揭示的随机材料,64 位十六进制。",
          "type": "string"
        },
        "world": {
          "type": "string"
        }
      },
      "required": [
        "world",
        "request_id",
        "server_seed",
        "client_seed",
        "born_at"
      ],
      "type": "object"
    },
    "BirthResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Birth"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Branch": {
      "oneOf": [
        {
          "enum": [
            "curious",
            "gentle",
            "steady",
            "sage",
            "guardian",
            "wanderer"
          ],
          "type": "string"
        },
        {
          "const": "radiant",
          "description": "后天罕见形态:不改变出生稀有度,只记录在 acquired_rarity。",
          "type": "string"
        }
      ]
    },
    "BranchOption": {
      "properties": {
        "branch": {
          "$ref": "#/$defs/Branch"
        },
        "eligible": {
          "type": "boolean"
        },
        "missing": {
          "items": {
            "$ref": "#/$defs/Missing"
          },
          "type": "array"
        },
        "to_stage": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "branch",
        "to_stage",
        "eligible",
        "missing"
      ],
      "type": "object"
    },
    "Capability": {
      "description": "一项可调用能力。能力发现、CLI 帮助与文档都由这张表产出,新增命令必须在此登记。",
      "properties": {
        "errors": {
          "description": "该能力可能返回的业务错误分类。",
          "items": {
            "$ref": "#/$defs/ErrorCode"
          },
          "type": "array"
        },
        "mutates_state": {
          "description": "是否产生需要持久化的状态变化(调用方负责提交,核心不写存储)。",
          "type": "boolean"
        },
        "op": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "summary",
        "mutates_state",
        "errors"
      ],
      "type": "object"
    },
    "CapabilityCatalog": {
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        },
        "rules_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rules_version",
        "capabilities"
      ],
      "type": "object"
    },
    "CapabilityCatalogResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/CapabilityCatalog"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Certificate": {
      "properties": {
        "accept_sig": {
          "description": "服务端承诺在先、接受客户端随机在后的签名收据。",
          "type": "string"
        },
        "client_seed": {
          "type": "string"
        },
        "commit_sig": {
          "type": "string"
        },
        "commitment": {
          "description": "先于客户端随机材料公布。",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "id": {
          "type": "string"
        },
        "rarity": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "server_seed": {
          "type": "string"
        },
        "species": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "context",
        "commitment",
        "commit_sig",
        "client_seed",
        "accept_sig",
        "server_seed",
        "id",
        "rarity",
        "species"
      ],
      "type": "object"
    },
    "Charset": {
      "enum": [
        "ascii",
        "unicode"
      ],
      "type": "string"
    },
    "Command": {
      "description": "线上命令:`op` 为判别字段。",
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "capabilities",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "now": {
              "type": "string"
            },
            "op": {
              "const": "grant",
              "type": "string"
            },
            "pet": {
              "$ref": "#/$defs/Pet"
            },
            "request_id": {
              "type": "string"
            },
            "reward": {
              "$ref": "#/$defs/Reward"
            }
          },
          "required": [
            "op",
            "pet",
            "reward",
            "now",
            "request_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "op": {
              "const": "evolution_options",
              "type": "string"
            },
            "pet": {
              "$ref": "#/$defs/Pet"
            }
          },
          "required": [
            "op",
            "pet"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/BirthInput",
          "properties": {
            "op": {
              "const": "birth",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/FrameInput",
          "properties": {
            "op": {
              "const": "frame",
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "properties": {
            "certificate": {
              "$ref": "#/$defs/Certificate"
            },
            "issuer_keys": {
              "items": {
                "$ref": "#/$defs/IssuerKey"
              },
              "type": "array"
            },
            "op": {
              "const": "verify_birth",
              "type": "string"
            }
          },
          "required": [
            "op",
            "certificate",
            "issuer_keys"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "$ref": "#/$defs/Action"
            },
            "now": {
              "type": "string"
            },
            "op": {
              "const": "act",
              "type": "string"
            },
            "pet": {
              "$ref": "#/$defs/Pet"
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "pet",
            "action",
            "now",
            "request_id"
          ],
          "type": "object"
        }
      ]
    },
    "Context": {
      "description": "本次领取固定的上下文:世界、发行者、请求、资格与规则摘要。",
      "properties": {
        "eligibility": {
          "description": "领取资格摘要,不含账号标识或原始活动。",
          "type": "string"
        },
        "issued_at": {
          "description": "签发方声称的签发时间(逻辑时间)。它由签名保护但由签发方自报,\n所以撤销被盗密钥时应取最早可能的泄露时间,见 pet/docs/birth-protocol.md。",
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "kid": {
          "description": "签名密钥标识。验证方按它在密钥集中选择公钥,从而支持轮换。",
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "rules_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "world": {
          "type": "string"
        }
      },
      "required": [
        "world",
        "issuer",
        "kid",
        "request_id",
        "eligibility",
        "rules_version",
        "issued_at"
      ],
      "type": "object"
    },
    "ErrorBody": {
      "description": "失败响应信封。",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "业务错误分类。调用方按此分支处理,`message` 仅供人读。",
      "oneOf": [
        {
          "const": "bad_input",
          "description": "输入无法解析或字段非法。",
          "type": "string"
        },
        {
          "const": "dead",
          "description": "宠物已死亡,任何照料动作都被拒绝。",
          "type": "string"
        },
        {
          "const": "no_food",
          "description": "库存没有食物。",
          "type": "string"
        },
        {
          "const": "no_medicine",
          "description": "库存没有药品。",
          "type": "string"
        },
        {
          "const": "not_sick",
          "description": "宠物未处于生病阶段,无需治疗。",
          "type": "string"
        },
        {
          "const": "too_tired",
          "description": "精力不足以玩耍。",
          "type": "string"
        },
        {
          "const": "time_backwards",
          "description": "`now` 早于宠物记录的 `last_tick`。",
          "type": "string"
        },
        {
          "const": "unsupported_rules",
          "description": "宠物保存时的规则版本不被当前实现支持,拒绝结算而不是猜测迁移。",
          "type": "string"
        },
        {
          "const": "not_eligible",
          "description": "进化条件未满足;缺项说明用 evolution_options 查询。",
          "type": "string"
        },
        {
          "const": "invalid_reward",
          "description": "奖励超出单次允许的范围。",
          "type": "string"
        }
      ]
    },
    "EvolutionOptions": {
      "properties": {
        "level": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/BranchOption"
          },
          "type": "array"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "stage",
        "level",
        "options"
      ],
      "type": "object"
    },
    "EvolutionOptionsResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/EvolutionOptions"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Frame": {
      "properties": {
        "colors": {
          "description": "与 rows 逐字符对应的 256 色索引;0 表示不着色。",
          "items": {
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "h": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "w": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "w",
        "h",
        "rows",
        "colors"
      ],
      "type": "object"
    },
    "FrameInput": {
      "description": "帧合成输入:投影字段 + 呈现时钟。呈现时钟只影响动作相位,不影响任何养成结果。",
      "properties": {
        "charset": {
          "$ref": "#/$defs/Charset"
        },
        "genes": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "h": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "species": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "t": {
          "type": "string"
        },
        "w": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "species",
        "genes",
        "pose",
        "charset",
        "w",
        "h",
        "t"
      ],
      "type": "object"
    },
    "FrameResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Frame"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Growth": {
      "description": "成长状态。所有字段有默认值,保证没有该结构的旧存档仍可加载。",
      "properties": {
        "acquired_rarity": {
          "description": "后天罕见形态:0 无,1 为 Radiant。与出生稀有度无关,出生档位不变。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "base_traits": {
          "description": "出生底色,由基因决定,创建后不变。当前性格最多偏离底色 +200。",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "drift_day": {
          "description": "性格漂移预算所属的天(逻辑时间 / 1440)。",
          "type": "string"
        },
        "drift_used": {
          "description": "当天各维度已使用的漂移点数。",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "exp": {
          "description": "累计经验,至多 1500。",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lineage": {
          "description": "已选择的进化分支,按发生顺序。出生身份与基因不随进化改变。",
          "items": {
            "$ref": "#/$defs/Branch"
          },
          "type": "array"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "topics": {
          "description": "主题倾向,至多 8 项。",
          "items": {
            "$ref": "#/$defs/TopicCount"
          },
          "type": "array"
        },
        "traits": {
          "description": "当前性格:好奇、亲和、沉稳,各 0 到 1000。",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "exp",
        "stage",
        "lineage",
        "traits",
        "base_traits",
        "drift_day",
        "drift_used",
        "acquired_rarity",
        "topics"
      ],
      "type": "object"
    },
    "IssuerKey": {
      "description": "验证方信任的一把签发公钥及其有效期。",
      "properties": {
        "kid": {
          "type": "string"
        },
        "not_after": {
          "default": null,
          "description": "轮换后旧钥的结束时间(含);缺省表示仍在使用。已签发的旧证书在窗口内仍然有效。",
          "type": [
            "string",
            "null"
          ]
        },
        "not_before": {
          "description": "自该时间起签发的证书有效(含)。",
          "type": "string"
        },
        "public_key": {
          "description": "Ed25519 公钥,64 位十六进制。",
          "type": "string"
        },
        "revoked_at": {
          "default": null,
          "description": "撤销时间:自该时间起(含)签发的证书无效,之前的证书不受影响。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kid",
        "public_key",
        "not_before"
      ],
      "type": "object"
    },
    "Missing": {
      "description": "未满足的进化条件:还差多少。",
      "properties": {
        "have": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/MissingKind"
        },
        "need": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "have",
        "need"
      ],
      "type": "object"
    },
    "MissingKind": {
      "enum": [
        "level",
        "curious",
        "affection",
        "calm",
        "topic",
        "topic_variety",
        "food"
      ],
      "type": "string"
    },
    "Mood": {
      "description": "短期情绪,由身体状态派生,不存储,所以不会成为永久状态。",
      "enum": [
        "sick",
        "hungry",
        "tired",
        "happy",
        "content"
      ],
      "type": "string"
    },
    "Outcome": {
      "properties": {
        "mood": {
          "$ref": "#/$defs/Mood"
        },
        "pet": {
          "$ref": "#/$defs/Pet"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "pet",
        "phase",
        "mood",
        "replayed"
      ],
      "type": "object"
    },
    "OutcomeResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Outcome"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    },
    "Pet": {
      "properties": {
        "energy": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "energy_rem": {
          "default": 0,
          "description": "精力衰减的余数刻度。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "food": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "growth": {
          "$ref": "#/$defs/Growth",
          "default": {
            "acquired_rarity": 0,
            "base_traits": [
              500,
              500,
              500
            ],
            "drift_day": "0",
            "drift_used": [
              0,
              0,
              0
            ],
            "exp": 0,
            "lineage": [],
            "stage": "baby",
            "topics": [],
            "traits": [
              500,
              500,
              500
            ]
          },
          "description": "成长状态:经验、阶段、性格、主题倾向。缺省为初始值,兼容没有该字段的旧存档。"
        },
        "id": {
          "type": "string"
        },
        "last_request": {
          "type": "string"
        },
        "last_tick": {
          "type": "string"
        },
        "medicine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "neglect": {
          "description": "持续失养的逻辑时间,决定预警、生病与死亡。",
          "type": "string"
        },
        "rules_version": {
          "default": 1,
          "description": "个体出生时所用的规则版本。缺省为 1，兼容该字段出现之前保存的个体。",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "satiety": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "satiety_rem": {
          "default": 0,
          "description": "饱食衰减的余数刻度,保证结算频率不影响总衰减量。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "satiety",
        "energy",
        "food",
        "medicine",
        "neglect",
        "last_tick",
        "last_request"
      ],
      "type": "object"
    },
    "Phase": {
      "enum": [
        "healthy",
        "warned",
        "sick",
        "dead"
      ],
      "type": "string"
    },
    "Pose": {
      "description": "姿态。眨眼由呈现时钟自动产生,不单独设姿态;移动随身体结构变化(见 `Body`)。",
      "oneOf": [
        {
          "enum": [
            "eat",
            "play",
            "sleep",
            "startled",
            "sick",
            "evolve"
          ],
          "type": "string"
        },
        {
          "const": "idle",
          "description": "待机并随结构移动。",
          "type": "string"
        },
        {
          "const": "observe",
          "description": "注视前方并停下。",
          "type": "string"
        },
        {
          "const": "end",
          "description": "生命终结(纪念形象):灰色、静止。",
          "type": "string"
        }
      ]
    },
    "Reward": {
      "description": "经服务裁决后发放的奖励。核心只校验单次上限,不决定谁有资格(见 ADR-0021)。",
      "properties": {
        "exp": {
          "description": "经验,单次至多 100。",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "food": {
          "description": "食物,单次至多 10。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "medicine": {
          "description": "药品,单次至多 3。",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "topic": {
          "description": "接入方映射后的主题标签,至多 32 字节;缺省则不记录主题。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "exp",
        "food",
        "medicine"
      ],
      "type": "object"
    },
    "Stage": {
      "enum": [
        "baby",
        "young",
        "adult"
      ],
      "type": "string"
    },
    "TopicCount": {
      "description": "主题倾向:接入方映射后的主题标签及累计次数。",
      "properties": {
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "topic",
        "count"
      ],
      "type": "object"
    },
    "Verdict": {
      "oneOf": [
        {
          "enum": [
            "valid",
            "unsupported_rules",
            "bad_encoding",
            "commit_signature",
            "commitment_mismatch",
            "accept_signature",
            "result_mismatch"
          ],
          "type": "string"
        },
        {
          "const": "unknown_key",
          "description": "密钥集中没有证书所标明的 kid。",
          "type": "string"
        },
        {
          "const": "key_not_valid",
          "description": "签发时间不在该密钥的有效窗口内。",
          "type": "string"
        },
        {
          "const": "key_revoked",
          "description": "签发时间不早于该密钥的撤销时间。",
          "type": "string"
        }
      ]
    },
    "VerdictResult": {
      "description": "成功响应信封。",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "ok",
        "value"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pet wire protocol",
  "x-capabilities": {
    "capabilities": [
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": true,
        "op": "birth",
        "summary": "由出生输入派生个体身份、稀有度、物种与基因"
      },
      {
        "errors": [
          "bad_input",
          "dead",
          "no_food",
          "no_medicine",
          "not_sick",
          "too_tired",
          "time_backwards",
          "unsupported_rules",
          "not_eligible"
        ],
        "mutates_state": true,
        "op": "act",
        "summary": "对宠物执行喂食、休息、玩耍、治疗或等待,按逻辑时间结算病程"
      },
      {
        "errors": [
          "bad_input",
          "dead",
          "invalid_reward",
          "time_backwards",
          "unsupported_rules"
        ],
        "mutates_state": true,
        "op": "grant",
        "summary": "发放经服务裁决后的奖励(经验、食物、药品、主题倾向);核心只校验单次上限"
      },
      {
        "errors": [
          "bad_input"
        ],
        "mutates_state": false,
        "op": "evolution_options",
