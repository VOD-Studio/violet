# Go / YAML / Makefile / 根级 JSON
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
max_line_length = 100

# Shell 脚本保持 2 空格
[*.sh]
indent_size = 2

# YAML 语法不允许 tab
[**.{yml,yaml}]
indent_style = space
indent_size = 2

# 根级 JSON 由 npm / release-please 管理（2 空格）；web/ 下 JSON 归 Biome 管（tab），不受本节影响
[*.json]
indent_style = space
indent_size = 2

# Markdown 行尾双空格是硬换行语法，不能 trim
[**.md]
trim_trailing_whitespace = false
max_line_length = off
