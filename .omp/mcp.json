{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "zai-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@z_ai/mcp-server"
      ],
      "env": {
        "Z_AI_API_KEY": "${Z_AI_MCP_PAT}",
        "Z_AI_MODE": "ZHIPU"
      }
    },
    "web-search-prime": {
      "type": "http",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_MCP_PAT}"
      }
    },
    "web-reader": {
      "type": "http",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_MCP_PAT}"
      }
    },
    "zread": {
      "type": "http",
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_MCP_PAT}"
      }
    },
    "violet-posts": {
      "type": "http",
      "url": "https://xunrua.top/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${VIOLET_MCP_PAT}"
      }
    },
    "violet-scraper": {
      "type": "http",
      "url": "https://xunrua.top/api/v1/mcp/scraper",
      "headers": {
        "Authorization": "Bearer ${VIOLET_MCP_PAT}"
      }
    },
    "violet-reader": {
      "type": "http",
      "url": "https://xunrua.top/api/v1/mcp/reader"
    },
    "violet-comments": {
      "type": "http",
      "url": "https://xunrua.top/api/v1/mcp/comments",
      "headers": {
        "Authorization": "Bearer ${VIOLET_MCP_PAT}"
      }
    }
  }
}
