# Dockerfile.dev - 开发环境 Go API 容器配置 (支持 Air 热重载)
FROM golang:1.25-alpine

ENV GOPROXY=https://goproxy.cn,direct

# 安装运行时 C 库/工具 (ffmpeg 用于视频抽取封面，wget/ca-certificates/git)
# 替换为国内阿里云源，加速 apk 下载
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories

RUN apk add --no-cache ca-certificates wget ffmpeg git

# 安装 air (Go 热重载工具)
# 锁定与 Go 1.25 兼容的 air 版本，避免 @latest 引用要求 Go >= 1.26 的新版
RUN go install github.com/air-verse/air@v1.61.7

WORKDIR /app

EXPOSE 9090

CMD ["air"]
