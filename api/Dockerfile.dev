# Dockerfile.dev - 开发环境 Go API 容器配置 (Air 热重载)
# 源码由 docker compose watch sync 实时同步，依赖变更触发自动 rebuild

# 与生产镜像使用相同的固定版本和静态编码器。
FROM alpine:3.20 AS webp-builder
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories && \
    (apk add --no-cache build-base libpng-dev libpng-static zlib-static || \
     (sed -i 's#mirrors.aliyun.com#dl-cdn.alpinelinux.org#g' /etc/apk/repositories && \
      apk add --no-cache build-base libpng-dev libpng-static zlib-static))
WORKDIR /build
RUN wget -q https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz && \
    echo "e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564  libwebp-1.6.0.tar.gz" | sha256sum -c - && \
    tar -xzf libwebp-1.6.0.tar.gz && \
    cd libwebp-1.6.0 && \
    LIBS="-lz" ./configure --disable-shared --enable-static --disable-jpeg --disable-tiff --disable-gif --disable-sdl --disable-gl --disable-threading && \
    make -j2 LDFLAGS="-all-static" && cp examples/cwebp /cwebp && \
    printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DQAAAEgQGALFXOsAAAAABJRU5ErkJggg==' | base64 -d > /tmp/encoder-probe.png && \
    /cwebp -quiet /tmp/encoder-probe.png -o /tmp/encoder-probe.webp

FROM golang:1.26.10-alpine

ENV GOPROXY=https://goproxy.cn,direct

# 优先使用国内镜像；镜像不可用时回退官方源，避免构建被单一镜像阻断。
# ffmpeg 用于视频封面，pg_dump/psql 用于系统备份。
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories && \
    (apk add --no-cache build-base ca-certificates wget ffmpeg git postgresql-client tar || \
     (sed -i 's#mirrors.aliyun.com#dl-cdn.alpinelinux.org#g' /etc/apk/repositories && \
      apk add --no-cache build-base ca-certificates wget ffmpeg git postgresql-client tar))

# 安装 air (Go 热重载工具)
RUN go install github.com/air-verse/air@latest

WORKDIR /app

# 先复制 go.mod/go.sum，利用 Docker 层缓存：依赖不变时跳过 download
# 不用 BuildKit cache mount：/go/pkg/mod 的下载产物需持久化到镜像层，
# 容器运行时 air 编译直接复用；cache mount 卸载后镜像内为空，会导致每次
# 重建容器后首次编译全量重新下载依赖
COPY go.mod go.sum ./
RUN go mod download

# 复制源码（初始状态，后续由 docker compose watch sync 实时更新）
COPY --chown=65532:65532 . .
COPY --from=webp-builder /cwebp /usr/local/bin/cwebp

RUN addgroup -g 65532 -S appgroup && adduser -u 65532 -S appuser -G appgroup && \
    mkdir -p /app/uploads /app/backups /app/tmp /home/appuser/.cache/go-build && \
    chown -R 65532:65532 /app /go /home/appuser
ENV HOME=/home/appuser GOCACHE=/home/appuser/.cache/go-build
USER appuser:appgroup


EXPOSE 9090

CMD ["air"]
