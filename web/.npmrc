# web 包管理器配置
#
# 修复 npm 在某些环境下的 workspace 自动探测问题。
# pnpm 使用默认 hoist（提升依赖到顶层 node_modules），
# 确保 @vitejs/plugin-react 等包能找到 react-refresh 等隐式依赖。

# 禁用 workspace 探测（避免 npm 向上查找根 package.json）
workspaces=false

# 允许 hoist（pnpm 默认，确保依赖可达）
# 设为 true 而非 false，否则 react-refresh 等间接依赖无法被 plugin-react 发现
hoist=true

# 引擎严格校验（Node 版本不符则报错而非警告）
engine-strict=true

# React Fast Refresh 的依赖需在顶层可达
# （@vitejs/plugin-react 依赖 react-refresh 但未声明为 peerDep）
public-hoist-pattern[]=react-refresh
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom

# 禁用 minimumReleaseAge 检查，避免发布时间过新的依赖被阻止安装
minimum-release-age=0
