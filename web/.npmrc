# web 包管理器配置
#
# 修复 npm 在某些环境下的 workspace 自动探测问题：
# npm 会尝试向上查找根 package.json 并把当前目录当 workspace 子包，
# 导致依赖装错位置或被跳过。显式声明本项目独立，禁用 workspace 探测。

# 禁用 workspace 探测（避免向上查找根 package.json）
workspaces=false

# 强制本地安装（不向上查找 node_modules）
hoist=false

# 引擎严格校验（Node 版本不符则报错而非警告）
engine-strict=true

# 禁用 minimumReleaseAge 检查，避免发布时间过新的依赖被阻止安装
minimum-release-age=0
