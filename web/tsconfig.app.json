{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    /* 模块解析：使用 bundler 模式 */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* 严格类型检查（启用全部 strict 家族选项） */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    /* 额外安全检查 */
    "noUncheckedIndexedAccess": false, /* TODO(P2): 开启并修复 ~50 处数组索引访问，再设为 true */
    "exactOptionalPropertyTypes": false,
    /* 路径别名配置（TS 5.4+ 无需 baseUrl，paths 相对于当前 tsconfig 解析） */
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    /* 代码检查规则 */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src"
  ]
}