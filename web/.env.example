# 客户端：浏览器同源相对路径（由反向代理转发到后端）
VITE_API_BASE_URL=/api/v1
# 前端对外地址（SEO、OpenGraph）
VITE_SITE_URL=http://localhost:5173
# dev 反向代理目标（浏览器请求 /api/* /uploads/* 实际转发到这里），默认 http://localhost:9090
VITE_API_PROXY_TARGET=http://localhost:9090
# SSR server 端：内网直连后端，绕过反向代理
# 生产环境填 docker network 内部地址如 http://api:9090/api/v1
VITE_SSR_API_BASE_URL=http://localhost:9090/api/v1
# Google OAuth
VITE_GOOGLE_CLIENT_ID=
