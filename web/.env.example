# ── API 地址 ─────────────────────────────────
# 后端 API 基础地址（含 /api/v1 前缀）
VITE_API_URL=http://localhost:8080/api/v1

# 后端服务器根地址（不含 API 前缀，用于拼接上传文件等静态资源 URL）
VITE_SERVER_ORIGIN=http://localhost:8080

# 站点公开访问 URL（SEO、og 标签、邮件链接用）
VITE_SITE_URL=http://localhost:5173

# ── GitHub 集成 ──────────────────────────────
# 仅需 public_repo 只读权限的 Fine-grained token
VITE_GITHUB_TOKEN=github_pat_CHANGE_ME

# ── 功能开关 ─────────────────────────────────
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_GISCUS=false
