# syntax=docker/dockerfile:1.7
# Dockerfile.dev - 开发环境 React Web 容器配置 (Vite HMR)
# 源码由 docker compose watch sync 实时同步，依赖变更触发自动 rebuild
FROM node:22-alpine

RUN corepack enable
# 换国内源加速
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories

WORKDIR /app

# 预先创建 public 目录，防止 postinstall (copy pdf.worker.min.mjs) 报错
RUN mkdir -p public

# 先复制包管理文件，利用 Docker 层缓存与 BuildKit 缓存：依赖不变时跳过 install
# pnpm-workspace.yaml 承载 pnpm v11 settings（allowBuilds 等），install 时必须存在
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# 复制源码（初始状态，后续由 docker compose watch sync 实时更新；
# node_modules 由 .dockerignore 排除，镜像内依赖不被宿主覆盖）
COPY . .

EXPOSE 5173

CMD ["pnpm", "dev", "--host", "0.0.0.0"]
