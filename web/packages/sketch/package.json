{
	"name": "@violet/sketch",
	"version": "0.1.0",
	"private": true,
	"description": "Backend-independent vector ink with extensible pens and fixed-quality budgets",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"path-data-parser": "0.1.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"typescript": "^7.0.2",
		"vite": "^8.0.0"
	}
}
