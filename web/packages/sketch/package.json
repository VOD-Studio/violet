{
	"name": "@violet/sketch",
	"version": "0.2.0",
	"private": true,
	"description": "Hand-drawn vector sketching with composable pens, hands and fills",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./svg": {
			"types": "./src/render/svg.ts",
			"import": "./src/render/svg.ts",
			"default": "./src/render/svg.ts"
		},
		"./canvas": {
			"types": "./src/render/canvas.ts",
			"import": "./src/render/canvas.ts",
			"default": "./src/render/canvas.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./svg": {
				"types": "./dist/render/svg.d.ts",
				"import": "./dist/render/svg.js",
				"default": "./dist/render/svg.js"
			},
			"./canvas": {
				"types": "./dist/render/canvas.d.ts",
				"import": "./dist/render/canvas.js",
				"default": "./dist/render/canvas.js"
			}
		}
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"path-data-parser": "0.1.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.3"
	}
}
