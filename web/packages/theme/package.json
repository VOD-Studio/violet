{
	"name": "@violetjs/theme",
	"version": "0.1.0",
	"description": "Generate accessible 12-step brand and neutral color scales from a single seed color, for light and dark appearances.",
	"keywords": [
		"color",
		"theme",
		"oklch",
		"contrast",
		"wcag",
		"apca",
		"accessibility",
		"css-variables",
		"dark-mode"
	],
	"license": "MIT",
	"homepage": "https://github.com/VOD-Studio/violet/tree/release/2.0/web/packages/theme#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VOD-Studio/violet.git",
		"directory": "web/packages/theme"
	},
	"bugs": {
		"url": "https://github.com/VOD-Studio/violet/issues"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"files": [
		"dist",
		"README.md",
		"README.zh-CN.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config vitest.config.ts",
		"consumer": "node scripts/consumer-smoke.mjs",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^22.20.0",
		"apca-w3": "0.1.9",
		"colorjs.io": "0.7.1",
		"esbuild": "^0.28.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.9"
	}
}
