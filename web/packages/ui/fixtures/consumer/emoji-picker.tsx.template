export function EmojiPickerConsumer() {
	const [group, setGroup] = useState("small");
	const [text, setText] = useState("");
	return (
		<main>
			<h1>写评论</h1>
			<textarea
				aria-label="评论内容"
				value={text}
				onChange={(event) => setText(event.target.value)}
			/>
			<EmojiPickerPanel
				groups={emojiGroups}
				activeGroup={group}
				onGroupChange={setGroup}
				onSelect={(item) => setText((value) => value + item.placeholder)}
			/>
		</main>
	);
}
