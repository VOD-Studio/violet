import assert from "node:assert/strict";
import { renderToString } from "react-dom/server";
import { Accordion, AccordionItem, DataTable, List, ListItem, ListItemContent, ListItemTitle, Pagination, Tree } from "@violet/ui";
import { Accordion as LeafAccordion, AccordionItem as LeafAccordionItem } from "@violet/ui/accordion";
import { List as LeafList, ListItem as LeafListItem, ListItemContent as LeafListItemContent, ListItemTitle as LeafListItemTitle } from "@violet/ui/list";
import { Tree as LeafTree } from "@violet/ui/tree";
import { Pagination as LeafPagination } from "@violet/ui/pagination";
import { DataTable as LeafDataTable } from "@violet/ui/table";

for (const [Root, Item] of [[Accordion, AccordionItem], [LeafAccordion, LeafAccordionItem]] as const) {
	const html = renderToString(
		<Root type="single" defaultValue="b">
			<Item value="a" title="甲" summary="摘要">甲内容</Item>
			<Item value="b" title="乙">乙内容</Item>
		</Root>,
	);
	assert.equal((html.match(/<h3\b/g) ?? []).length, 2);
	assert.match(html, /aria-expanded="false"/);
	assert.match(html, /aria-expanded="true"/);
	assert.equal((html.match(/role="region"/g) ?? []).length, 2);
	// 收起的内容常驻 DOM 且 inert，展开的不带。
	assert.equal((html.match(/inert=""/g) ?? []).length, 1);
	assert.match(html, /摘要/);
}

for (const [Root, Item, Content, Title] of [[List, ListItem, ListItemContent, ListItemTitle], [LeafList, LeafListItem, LeafListItemContent, LeafListItemTitle]] as const) {
	const html = renderToString(
		<Root aria-label="设置">
			<Item aria-current="page"><Content><Title>外观</Title></Content></Item>
			<Item onClick={() => {}}><Title>语言</Title></Item>
		</Root>,
	);
	assert.match(html, /<ul\b[^>]*aria-label="设置"/);
	assert.equal((html.match(/<li\b/g) ?? []).length, 2);
	assert.match(html, /<div\b[^>]*aria-current="page"/);
	assert.match(html, /<button\b[^>]*type="button"/);
}

for (const Component of [Tree, LeafTree]) {
	const html = renderToString(
		<Component
			aria-label="目录"
			defaultExpanded={["a"]}
			defaultValue="a1"
			nodes={[{ value: "a", label: "甲", children: [{ value: "a1", label: "甲一" }] }, { value: "b", label: "乙" }]}
		/>,
	);
	assert.match(html, /role="tree"/);
	assert.equal((html.match(/role="treeitem"/g) ?? []).length, 3);
	assert.match(html, /aria-level="2"/);
	assert.match(html, /aria-expanded="true"/);
	assert.match(html, /aria-activedescendant=/);
}

for (const Component of [Pagination, LeafPagination]) {
	const html = renderToString(<Component page={3} totalPages={9} onPageChange={() => {}} />);
	assert.match(html, /<nav\b[^>]*aria-label="分页"/);
	assert.match(html, /aria-current="page"/);
	assert.match(html, /aria-label="上一页"/);
	assert.match(html, /aria-label="下一页"/);
}

interface Row { id: string; title: string; views: number }
const columns = [
	{ key: "title", header: "标题", accessorKey: "title" as const, sortable: true },
	{ key: "views", header: "浏览", accessorKey: "views" as const, align: "right" as const },
];
const row: Row = { id: "1", title: "独库公路", views: 12 };
for (const Component of [DataTable, LeafDataTable]) {
	const data = renderToString(
		<Component
			caption="文章"
			columns={columns}
			data={[row]}
			keyExtractor={(item: Row) => item.id}
			sort={{ key: "title", order: "asc" }}
			selectable
			pagination={{ page: 1, pageSize: 10, total: 25, onChange: () => {} }}
		/>,
	);
	assert.match(data, /<table\b/);
	assert.match(data, /role="region"[^>]*tabindex="0"|tabindex="0"[^>]*role="region"/);
	assert.match(data, /aria-sort="ascending"/);
	assert.match(data, /独库公路/);
	assert.match(data, /aria-label="全选本页"/);
	assert.match(data, /aria-label="每页条数"/);
	const loading = renderToString(<Component columns={columns} data={[]} keyExtractor={(item: Row) => item.id} loading />);
	assert.match(loading, /aria-busy="true"/);
	const failed = renderToString(<Component columns={columns} data={[]} keyExtractor={(item: Row) => item.id} error={new Error("502")} onRetry={() => {}} />);
	assert.match(failed, /role="alert"/);
	assert.match(failed, /502/);
	assert.match(failed, /重试/);
}
console.log("Installed accordion, list, tree, pagination and table root/leaf SSR semantics passed.");
