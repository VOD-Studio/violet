const modalTree = (Root: typeof Dialog, Trigger: typeof DialogTrigger, Content: typeof DialogContent, Title: typeof DialogTitle, name: string) => (
	<Root><Trigger asChild><button type="button">{name}</button></Trigger><Content aria-describedby={undefined}><Title>{name}</Title>框里的内容</Content></Root>
);
const dialog = renderToString(modalTree(Dialog, DialogTrigger, DialogContent, DialogTitle, "编辑资料"));
assert.equal(dialog, renderToString(modalTree(LeafDialog, LeafDialogTrigger, LeafDialogContent, LeafDialogTitle, "编辑资料")));
assert.match(dialog, /aria-haspopup="dialog"/);
assert.match(dialog, /aria-expanded="false"/);
assert.doesNotMatch(dialog, /框里的内容/);
const sheet = renderToString(modalTree(Sheet as typeof Dialog, SheetTrigger as typeof DialogTrigger, SheetContent as typeof DialogContent, SheetTitle as typeof DialogTitle, "筛选"));
assert.equal(sheet, renderToString(modalTree(LeafSheet as typeof Dialog, LeafSheetTrigger as typeof DialogTrigger, LeafSheetContent as typeof DialogContent, LeafSheetTitle as typeof DialogTitle, "筛选")));
assert.match(sheet, /aria-haspopup="dialog"/);
assert.doesNotMatch(sheet, /框里的内容/);
const drawer = renderToString(modalTree(Drawer as typeof Dialog, DrawerTrigger as typeof DialogTrigger, DrawerContent as typeof DialogContent, DrawerTitle as typeof DialogTitle, "分享"));
assert.equal(drawer, renderToString(modalTree(LeafDrawer as typeof Dialog, LeafDrawerTrigger as typeof DialogTrigger, LeafDrawerContent as typeof DialogContent, LeafDrawerTitle as typeof DialogTitle, "分享")));
assert.match(drawer, /aria-haspopup="dialog"/);
assert.doesNotMatch(drawer, /框里的内容/);
// 关闭的模态单元在服务端不输出任何内容
for (const [name, node, leaf] of [
	["Modal", <Modal open={false} onOpenChange={() => {}} title="新建角色">表单</Modal>, <LeafModal open={false} onOpenChange={() => {}} title="新建角色">表单</LeafModal>],
	["ConfirmDialog", <ConfirmDialog open={false} onOpenChange={() => {}} title="永久删除？" onConfirm={() => {}} />, <LeafConfirmDialog open={false} onOpenChange={() => {}} title="永久删除？" onConfirm={() => {}} />],
	["PromptDialog", <PromptDialog open={false} onOpenChange={() => {}} title="重命名" onConfirm={() => {}} />, <LeafPromptDialog open={false} onOpenChange={() => {}} title="重命名" onConfirm={() => {}} />],
	["CommandList", <CommandList open={false} onOpenChange={() => {}} items={[]} groups={[]} query="" onQueryChange={() => {}} />, <LeafCommandList open={false} onOpenChange={() => {}} items={[]} groups={[]} query="" onQueryChange={() => {}} />],
] as const) {
	assert.equal(renderToString(node), "", `${name} rendered while closed.`);
	assert.equal(renderToString(leaf), "", `Leaf ${name} rendered while closed.`);
}
const morphTree = (Root: typeof MorphingPopover, Trigger: typeof MorphingPopoverTrigger, Content: typeof MorphingPopoverContent, open: boolean) => (
	<Root defaultOpen={open}><Trigger asChild><button type="button">状态</button></Trigger><Content aria-label="状态详情"><b>此刻在听</b></Content></Root>
);
const morph = renderToString(morphTree(MorphingPopover, MorphingPopoverTrigger, MorphingPopoverContent, false));
assert.equal(morph, renderToString(morphTree(LeafMorphingPopover, LeafMorphingPopoverTrigger, LeafMorphingPopoverContent, false)));
assert.match(morph, /aria-expanded="false"/);
assert.match(morph, /aria-controls="[^"]+"/);
assert.doesNotMatch(morph, /此刻在听/);
// 默认展开时服务端就输出面板；锚点与动效模式由脚本在客户端写，服务端不输出
const morphOpen = renderToString(morphTree(MorphingPopover, MorphingPopoverTrigger, MorphingPopoverContent, true));
assert.equal(morphOpen, renderToString(morphTree(LeafMorphingPopover, LeafMorphingPopoverTrigger, LeafMorphingPopoverContent, true)));
assert.match(morphOpen, /aria-expanded="true"/);
assert.match(morphOpen, /role="dialog"/);
assert.match(morphOpen, /aria-label="状态详情"/);
assert.match(morphOpen, /此刻在听/);
assert.doesNotMatch(morphOpen, /data-anchor|data-motion/);
console.log("Independent root/leaf SSR, Input, Select, Checkbox, ImagePixelReveal, UploadTile, Dropdown, Segmented, Avatar, Badge, Kbd, Card, Separator, Skeleton, Popover, HoverCard, Tooltip, DropdownMenu, ContextMenu, Toaster, Dialog, Modal, ConfirmDialog, PromptDialog, Sheet, Drawer, CommandList and MorphingPopover semantics passed.");
