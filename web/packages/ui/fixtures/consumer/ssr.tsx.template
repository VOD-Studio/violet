import assert from "node:assert/strict";
import { Button, Checkbox, ImagePixelReveal, Input, type PixelRevealVariant } from "@violet/ui";
import { Button as LeafButton } from "@violet/ui/button";
import { Checkbox as LeafCheckbox } from "@violet/ui/checkbox";
import { ImagePixelReveal as LeafImagePixelReveal } from "@violet/ui/image-pixel-reveal";
import { Input as LeafInput } from "@violet/ui/input";
import { buttonVariants, checkboxVariants } from "@violet/ui/variants";
import { renderToString } from "react-dom/server";
import { UploadTile } from "@violet/ui";
import { Dropdown, DropdownContent, DropdownGroup, DropdownTrigger } from "@violet/ui";
import { Dropdown as LeafDropdown, DropdownContent as LeafDropdownContent, DropdownGroup as LeafDropdownGroup, DropdownTrigger as LeafDropdownTrigger } from "@violet/ui/dropdown";
import { Segmented } from "@violet/ui";
import { Segmented as LeafSegmented } from "@violet/ui/segmented";
import { UploadTile as LeafUploadTile } from "@violet/ui/upload-tile";
import { LinkCard } from "@violet/ui";
import { LinkCard as LeafLinkCard } from "@violet/ui/link-card";
import { Avatar, AvatarGroup, Badge, BadgeAnchor, Card, CardFrame, CardFrameBody, CardFrameMeta, CardFrameTitle, CardHeader, CardTitle, Count, Dot, Kbd, KbdSeparator, Separator, Skeleton, Tag, TagToggle } from "@violet/ui";
import { Avatar as LeafAvatar, AvatarGroup as LeafAvatarGroup } from "@violet/ui/avatar";
import { Badge as LeafBadge, BadgeAnchor as LeafBadgeAnchor, Count as LeafCount, Tag as LeafTag, TagToggle as LeafTagToggle } from "@violet/ui/badge";
import { Card as LeafCard, CardFrame as LeafCardFrame, CardFrameBody as LeafCardFrameBody, CardFrameMeta as LeafCardFrameMeta, CardFrameTitle as LeafCardFrameTitle, CardHeader as LeafCardHeader, CardTitle as LeafCardTitle } from "@violet/ui/card";
import { Kbd as LeafKbd } from "@violet/ui/kbd";
import { Separator as LeafSeparator } from "@violet/ui/separator";
import { Skeleton as LeafSkeleton } from "@violet/ui/skeleton";
import { badgeVariants, countVariants, kbdVariants, tagVariants } from "@violet/ui/variants";

const cardProps = { href: "https://www.example.com/guide#native", title: "y_defect的推文", description: "@y_defect的推文", siteName: "EXAMPLE.COM", imageSrc: "https://example.com/logo.png", imageAlt: "Example logo" };
const card = renderToString(<LinkCard {...cardProps} />);
assert.equal(card, renderToString(<LeafLinkCard {...cardProps} />));
assert.match(card, /<a\b[^>]*href="https:\/\/www\.example\.com\/guide#native"/);
assert.match(card, /class="v-link-card"/);
assert.match(card, /target="_blank"/);
assert.match(card, /rel="noopener noreferrer nofollow"/);
assert.match(card, /<img\b[^>]*alt="Example logo"/);
assert.doesNotMatch(card, /@y_defect的推文|EXAMPLE\.COM/);
assert.equal((card.match(/>example\.com</g) ?? []).length, 1);
const textCard = renderToString(<LeafLinkCard href="/guide" title="本地指南" target="_self" />);
assert.doesNotMatch(textCard, /<img|v-link-card__thumbnail|v-link-card__host/);
assert.match(textCard, /target="_self"/);
assert.match(textCard, /本地指南/);

const uploadTile = renderToString(<UploadTile aria-label="添加图片" name="action" value="upload" />);
assert.equal(uploadTile, renderToString(<LeafUploadTile aria-label="添加图片" name="action" value="upload" />));
assert.match(uploadTile, /type="button"/);
assert.match(uploadTile, /class="v-upload-tile"/);
assert.match(uploadTile, /name="action"/);
assert.match(uploadTile, /value="upload"/);
const busyTile = renderToString(<LeafUploadTile busy aria-label="添加图片" />);
assert.match(busyTile, /disabled=""/);
assert.match(busyTile, /aria-busy="true"/);
assert.match(renderToString(<UploadTile type="submit">添加图片</UploadTile>), /type="submit"/);

const root = renderToString(<Button variant="primary">保存</Button>);
const leaf = renderToString(<LeafButton variant="primary">保存</LeafButton>);
assert.equal(root, leaf);
assert.match(root, /v-button--primary/);
const link = renderToString(<LeafButton asChild><a href="/settings">设置</a></LeafButton>);
assert.match(link, /^<a /);
assert.match(link, /href="\/settings"/);
assert.doesNotMatch(link, /<button/);
const field = renderToString(<Input id="email" label="邮箱" description="用于发送更新" />);
assert.equal(field, renderToString(<LeafInput id="email" label="邮箱" description="用于发送更新" />));
assert.match(field, /for="email"/);
assert.match(field, /aria-describedby="email-description"/);
assert.match(buttonVariants({ variant: "primary" }), /v-button--primary/);
const checkbox = renderToString(<form><Checkbox id="updates" name="updates" value="weekly" defaultChecked required aria-label="订阅更新" /></form>);
assert.equal(checkbox, renderToString(<form><LeafCheckbox id="updates" name="updates" value="weekly" defaultChecked required aria-label="订阅更新" /></form>));
assert.match(checkbox, /role="checkbox"/);
assert.match(checkbox, /aria-checked="true"/);
assert.match(checkbox, /name="updates"/);
assert.match(checkbox, /value="weekly"/);
const mixed = renderToString(<Checkbox defaultChecked="indeterminate" aria-label="选择全部" />);
assert.match(mixed, /aria-checked="mixed"/);
assert.match(checkboxVariants({ variant: "primary" }), /v-checkbox--primary/);
const external = renderToString(<LeafCheckbox form="external" name="option" defaultChecked aria-label="表单外选择" />);
assert.match(external, /<button\b[^>]*form="external"/);
const imageSource = "data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22360%22%20height=%22240%22%3E%3Crect%20width=%22360%22%20height=%22240%22%20fill=%22%23406c83%22/%3E%3C/svg%3E";
const imageVariants: PixelRevealVariant[] = ["random", "ripple", "diagonal", "curtain"];
for (const variant of imageVariants) {
	const imageProps = { src: imageSource, alt: `${variant} 山间风景`, variant, replayOnHover: true, loading: "eager" as const };
	const image = renderToString(<ImagePixelReveal {...imageProps} />);
	assert.equal(image, renderToString(<LeafImagePixelReveal {...imageProps} />));
	assert.match(image, /<img\b[^>]*alt="[^"]*山间风景"/);
	assert.ok(image.includes(imageSource));
}
const customImage = renderToString(<LeafImagePixelReveal src={imageSource}><figure><img src={imageSource} alt="自定义风景" width={360} height={240} /><figcaption>自定义内容</figcaption></figure></LeafImagePixelReveal>);
assert.match(customImage, /<figure>/);
assert.match(customImage, /<figcaption>自定义内容<\/figcaption>/);

const dropdownTree = (Group: typeof DropdownGroup, Root: typeof Dropdown, Trigger: typeof DropdownTrigger, Content: typeof DropdownContent) => <Group>
	<Root>
		<Trigger>产品</Trigger>
		<Content><a href="/docs">文档面板</a></Content>
	</Root>
	<Root>
		<Trigger asChild><a href="/about">关于</a></Trigger>
		<Content><a href="/team">团队面板</a></Content>
	</Root>
</Group>;
const dropdown = renderToString(dropdownTree(DropdownGroup, Dropdown, DropdownTrigger, DropdownContent));
assert.equal(dropdown, renderToString(dropdownTree(LeafDropdownGroup, LeafDropdown, LeafDropdownTrigger, LeafDropdownContent)));
assert.match(dropdown, /<button\b[^>]*type="button"/);
assert.match(dropdown, /aria-expanded="false"/);
assert.doesNotMatch(dropdown, /aria-expanded="true"/);
assert.match(dropdown, /<a\b[^>]*href="\/about"/);
assert.match(dropdown, /data-state="closed"/);
assert.doesNotMatch(dropdown, /文档面板|团队面板/);
assert.doesNotMatch(dropdown, /v-dropdown__content/);
const viewSegments = [{ value: "grid", label: "网格" }, { value: "table", label: "表格" }];
const segmentedTree = (Root: typeof Segmented, equal: boolean) => <Root aria-label="视图" value="grid" segments={viewSegments} {...(equal ? { itemSize: "5rem" } : {})} />;
const segmented = renderToString(segmentedTree(Segmented, false));
assert.equal(segmented, renderToString(segmentedTree(LeafSegmented, false)));
assert.match(segmented, /role="group"/);
assert.match(segmented, /aria-pressed="true"/);
assert.match(segmented, /aria-pressed="false"/);
assert.doesNotMatch(segmented, /data-layout="equal"/);
const segmentedEqual = renderToString(segmentedTree(Segmented, true));
assert.equal(segmentedEqual, renderToString(segmentedTree(LeafSegmented, true)));
assert.match(segmentedEqual, /data-layout="equal"/);
assert.match(segmentedEqual, /--v-segmented-item-size:\s*5rem/);

const avatarProps = { name: "Rua", src: "https://example.com/rua.png", status: "online" as const };
const avatar = renderToString(<Avatar {...avatarProps} />);
assert.equal(avatar, renderToString(<LeafAvatar {...avatarProps} />));
assert.match(avatar, /<img\b[^>]*src="https:\/\/example\.com\/rua\.png"/);
assert.match(avatar, /role="img"[^>]*aria-label="Rua，在线"|aria-label="Rua，在线"[^>]*role="img"/);
assert.match(avatar, /data-state="loading"/);
const initialAvatar = renderToString(<LeafAvatar name="林" alt="" />);
assert.match(initialAvatar, /data-state="fallback"/);
assert.match(initialAvatar, />林</);
assert.doesNotMatch(initialAvatar, /role="img"|<img/);
const people = ["Rua", "Mika", "Noa", "Ken", "Yui"].map((name) => ({ name }));
const group = renderToString(<AvatarGroup items={people} label="5 人点了赞" />);
assert.equal(group, renderToString(<LeafAvatarGroup items={people} label="5 人点了赞" />));
assert.match(group, /role="group"/);
assert.match(group, /aria-label="还有 2 人"/);
assert.equal(renderToString(<AvatarGroup items={[]} />), "");

const tag = renderToString(<Tag onRemove={() => undefined}>shell</Tag>);
assert.equal(tag, renderToString(<LeafTag onRemove={() => undefined}>shell</LeafTag>));
assert.match(tag, /class="v-tag"/);
assert.match(tag, /<button\b[^>]*aria-label="移除 shell"/);
const tagLink = renderToString(<LeafTag asChild><a href="/tags/shell">shell</a></LeafTag>);
assert.match(tagLink, /^<a\b[^>]*href="\/tags\/shell"[^>]*class="v-tag"|^<a\b[^>]*class="v-tag"[^>]*href="\/tags\/shell"/);
const tagToggle = renderToString(<TagToggle pressed onPressedChange={() => undefined}>前端</TagToggle>);
assert.equal(tagToggle, renderToString(<LeafTagToggle pressed onPressedChange={() => undefined}>前端</LeafTagToggle>));
assert.match(tagToggle, /<button\b[^>]*aria-pressed="true"/);
const badge = renderToString(<Badge tone="ok">已发布</Badge>);
assert.equal(badge, renderToString(<LeafBadge tone="ok">已发布</LeafBadge>));
assert.match(badge, /v-badge--ok/);
assert.match(badge, /已发布/);
const count = renderToString(<Count value={120} />);
assert.equal(count, renderToString(<LeafCount value={120} />));
assert.match(count, />99\+</);
assert.match(count, /aria-hidden="true"/);
assert.equal(renderToString(<Count value={0} />), "");
assert.doesNotMatch(renderToString(<Count variant="inline" value={3} />), /aria-hidden/);
assert.match(renderToString(<Dot />), /aria-hidden="true"/);
const anchor = renderToString(<BadgeAnchor badge={<Count value={3} />}><button type="button" aria-label="消息，3 条未读">消息</button></BadgeAnchor>);
assert.equal(anchor, renderToString(<LeafBadgeAnchor badge={<LeafCount value={3} />}><button type="button" aria-label="消息，3 条未读">消息</button></LeafBadgeAnchor>));
assert.match(anchor, /data-placement="corner"/);
assert.match(badgeVariants({ tone: "danger" }), /v-badge--danger/);
assert.match(tagVariants({ size: "sm", tone: "accent" }), /v-tag--sm[\s\S]*v-tag--accent|v-tag--accent[\s\S]*v-tag--sm/);
assert.match(countVariants({ variant: "inline" }), /v-count--inline/);

const kbdCombo = renderToString(<Kbd keys={["mod", "K"]} />);
assert.equal(kbdCombo, renderToString(<LeafKbd keys={["mod", "K"]} />));
assert.match(kbdCombo, /^<kbd\b/);
assert.match(kbdCombo, /Ctrl/);
assert.doesNotMatch(kbdCombo, /⌘/);
const kbdMac = renderToString(<LeafKbd keys={["mod", "K"]} platform="mac" />);
assert.match(kbdMac, /⌘/);
assert.match(kbdMac, /aria-label="Command"/);
assert.match(renderToString(<Kbd>Esc</Kbd>), /<kbd\b[^>]*>.*Esc.*<\/kbd>/);
assert.match(renderToString(<KbdSeparator>或</KbdSeparator>), />或</);
assert.match(kbdVariants({ size: "sm", variant: "light" }), /v-kbd--sm/);

const frame = renderToString(<CardFrame><CardFrameBody><CardFrameTitle asChild><a href="/posts/season">给博客加了季节</a></CardFrameTitle><CardFrameMeta>2026-11-02</CardFrameMeta></CardFrameBody></CardFrame>);
assert.equal(frame, renderToString(<LeafCardFrame><LeafCardFrameBody><LeafCardFrameTitle asChild><a href="/posts/season">给博客加了季节</a></LeafCardFrameTitle><LeafCardFrameMeta>2026-11-02</LeafCardFrameMeta></LeafCardFrameBody></LeafCardFrame>));
assert.equal((frame.match(/<a\b/g) ?? []).length, 1);
assert.ok(frame.indexOf("给博客加了季节") < frame.indexOf("2026-11-02"), "Frame card title must precede meta in DOM order.");
const basicCard = renderToString(<Card><CardHeader><CardTitle>同步</CardTitle></CardHeader></Card>);
assert.equal(basicCard, renderToString(<LeafCard><LeafCardHeader><LeafCardTitle>同步</LeafCardTitle></LeafCardHeader></LeafCard>));
assert.match(basicCard, /class="v-card"/);

assert.match(renderToString(<Separator />), /role="none"/);
assert.equal(renderToString(<Separator />), renderToString(<LeafSeparator />));
assert.match(renderToString(<LeafSeparator decorative={false} />), /^<hr\b/);
const labelled = renderToString(<LeafSeparator>或</LeafSeparator>);
assert.match(labelled, /role="separator"/);
assert.match(labelled, /aria-labelledby=/);
const skeleton = renderToString(<Skeleton className="h-4" />);
assert.equal(skeleton, renderToString(<LeafSkeleton className="h-4" />));
assert.match(skeleton, /aria-hidden="true"/);
assert.match(skeleton, /class="v-skeleton h-4"/);
console.log("Independent root/leaf SSR, Input, Checkbox, ImagePixelReveal, UploadTile, Dropdown, Segmented, Avatar, Badge, Kbd, Card, Separator and Skeleton semantics passed.");
