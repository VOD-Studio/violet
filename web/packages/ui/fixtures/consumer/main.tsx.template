		<h1>Input 独立安装消费</h1>
		<div className="input-controls">
			<Button onClick={() => document.documentElement.classList.toggle("dark")}>切换明暗</Button>
			{["default", "invalid", "readonly", "disabled"].map((value) => <Button key={value} aria-pressed={state === value} onClick={() => setState(value)}>{value}</Button>)}
			{(["sm", "md", "lg"] as const).map((size) => <Button key={size} aria-pressed={controlSize === size} onClick={() => setControlSize(size)}>{size}</Button>)}
		</div>
		<section className="input-grid" aria-label="四种输入外观">
