import { Button, Checkbox, Dropdown, DropdownContent, DropdownGroup, DropdownTrigger, ImagePixelReveal, Label, SearchInput, TextField, UploadTile, type PixelRevealVariant } from "@violet/ui";
import { buttonVariants } from "@violet/ui/variants";
import checkboxCss from "@violet/ui/components/checkbox.css?raw";
import { useEffect, useRef, useState } from "react";
import { createRoot } from "react-dom/client";
import "./style.css";

function DropdownPreview() {
	const [products, setProducts] = useState(false);
	const [resources, setResources] = useState(false);
	const [narrow, setNarrow] = useState(false);
	const [dark, setDark] = useState(document.documentElement.classList.contains("dark"));
	return <main className="dropdown-page" data-narrow={narrow}>
		<h1>Dropdown · 独立安装包</h1>
		<p>悬停或 Tab 聚焦触发器展开面板；点击不开合，Escape 收起，触屏不展开。两个菜单互斥，组内切换立即展开。</p>
		<div className="image-reveal-controls">
			<Label htmlFor="dropdown-narrow"><Checkbox id="dropdown-narrow" checked={narrow} onCheckedChange={(checked) => setNarrow(checked === true)} />窄屏</Label>
			<Button id="dropdown-theme" onClick={() => {
				document.documentElement.classList.toggle("dark", !dark);
				setDark(!dark);
			}}>{dark ? "切换浅色" : "切换深色"}</Button>
		</div>
		<nav className="dropdown-nav" aria-label="悬停菜单">
			<DropdownGroup>
				<Dropdown onOpenChange={setProducts}>
					<DropdownTrigger id="dropdown-products">产品</DropdownTrigger>
					<DropdownContent className="dropdown-panel" align="start">
						<a href="#components">组件</a>
						<a href="#tokens">设计令牌</a>
						<a href="#themes">主题</a>
					</DropdownContent>
				</Dropdown>
				<Dropdown onOpenChange={setResources}>
					<DropdownTrigger asChild><a id="dropdown-resources" href="#resources">资源</a></DropdownTrigger>
					<DropdownContent className="dropdown-panel" align="start">
						<a href="#guides">指南</a>
						<a href="#changelog">更新日志</a>
					</DropdownContent>
				</Dropdown>
			</DropdownGroup>
		</nav>
		<output id="dropdown-state" aria-live="polite">产品：{products ? "展开" : "收起"}；资源：{resources ? "展开" : "收起"}</output>
	</main>;
}

function UploadTilePreview() {
	const [count, setCount] = useState(0);
	const [busy, setBusy] = useState(false);
	const [disabled, setDisabled] = useState(false);
	const [narrow, setNarrow] = useState(false);
	const [dark, setDark] = useState(document.documentElement.classList.contains("dark"));
	const ref = useRef<HTMLButtonElement>(null);
	return <main className="upload-tile-page" data-narrow={narrow}>
		<h1>UploadTile · 独立安装包</h1>
		<p>只记录激活次数，不执行文件选择或上传。Tab 聚焦后按 Enter 或 Space；忙碌或禁用时不可激活。</p>
		<div className="image-reveal-controls">
			<Label htmlFor="upload-tile-busy"><Checkbox id="upload-tile-busy" checked={busy} onCheckedChange={(checked) => setBusy(checked === true)} />忙碌</Label>
			<Label htmlFor="upload-tile-disabled"><Checkbox id="upload-tile-disabled" checked={disabled} onCheckedChange={(checked) => setDisabled(checked === true)} />禁用</Label>
			<Label htmlFor="upload-tile-narrow"><Checkbox id="upload-tile-narrow" checked={narrow} onCheckedChange={(checked) => setNarrow(checked === true)} />窄屏</Label>
			<Button id="upload-tile-theme" onClick={() => {
				document.documentElement.classList.toggle("dark", !dark);
				setDark(!dark);
			}}>{dark ? "切换浅色" : "切换深色"}</Button>
			<Button id="upload-tile-focus" onClick={() => ref.current?.focus()}>聚焦上传入口</Button>
		</div>
		<section className="upload-tile-grid" aria-label="上传入口状态">
			<UploadTile id="upload-tile-action" ref={ref} aria-label="添加图片" busy={busy} disabled={disabled} onClick={() => setCount((value) => value + 1)} />
			<UploadTile busy onClick={() => setCount((value) => value + 1)}>处理中</UploadTile>
			<UploadTile disabled onClick={() => setCount((value) => value + 1)}>不可用</UploadTile>
		</section>
		<output id="upload-tile-count" aria-live="polite">激活次数：{count}</output>
	</main>;
}

const revealVariants: PixelRevealVariant[] = ["ripple", "random", "diagonal", "curtain"];
const revealImage = `data:image/svg+xml,${encodeURIComponent(`
	<svg xmlns="http://www.w3.org/2000/svg" width="720" height="480" viewBox="0 0 720 480">
		<rect width="720" height="480" fill="#9ccee3" />
		<circle cx="568" cy="92" r="42" fill="#ffcf77" />
		<path d="M0 320 180 116 346 312 475 170 720 340V480H0Z" fill="#406c83" />
		<path d="m180 116-52 62 49-18 37 15Z" fill="#fff7e8" />
		<path d="M0 380 225 283 474 345 720 296V480H0Z" fill="#326a53" />
		<path d="m332 480 27-145h18l73 145Z" fill="#e5c59b" />
		<path d="M0 120H720M0 240H720M0 360H720M120 0V480M240 0V480M360 0V480M480 0V480M600 0V480" stroke="#fff" stroke-opacity=".24" />
		<rect x="12" y="12" width="696" height="456" fill="none" stroke="#fff7e8" stroke-width="4" />
		<path d="M344 240h32m-16-16v32" stroke="#ffcf77" stroke-width="4" />
	</svg>
`)}`;

function ImagePixelRevealPreview() {
	const [session, setSession] = useState(0);
	const [dark, setDark] = useState(document.documentElement.classList.contains("dark"));
	const [reveals, setReveals] = useState<Record<string, number>>({});
	const [errors, setErrors] = useState<string[]>([]);
	return <main className="image-reveal-page">
		<h1>ImagePixelReveal · 独立安装包</h1>
		<p>图片瓦片逐块裁剪展开，随机顺序每轮重新洗牌。边框、网格与中心十字可用于观察原图是否移动；悬停可重播拼合效果。</p>
		<div className="image-reveal-controls">
			<Button id="image-reveal-replay" onClick={() => {
				setSession((value) => value + 1);
				setReveals({});
				setErrors([]);
			}}>重播首次加载</Button>
			<Button id="image-reveal-theme" aria-pressed={dark} onClick={() => {
				const next = !dark;
				document.documentElement.classList.toggle("dark", next);
				setDark(next);
			}}>{dark ? "切换浅色" : "切换深色"}</Button>
			<a href="/">返回控件消费页</a>
		</div>
		<div className="image-reveal-grid">
			{revealVariants.map((variant) => <section key={variant} aria-label={`${variant} 图片揭示`}>
				<h2>{variant}</h2>
				<ImagePixelReveal
					key={`${variant}-${session}`}
					src={revealImage}
					alt={`${variant} 山间风景`}
					variant={variant}
					className="image-preview-frame"
					imgClassName="image-preview-image"
					loading="eager"
					replayOnHover
					onRevealed={() => setReveals((counts) => ({ ...counts, [variant]: (counts[variant] ?? 0) + 1 }))}
					onError={() => setErrors((items) => [...items, variant])}
				/>
				<output id={`image-reveal-${variant}-count`}>完成次数：{reveals[variant] ?? 0}</output>
			</section>)}
			<section aria-label="自定义内容揭示">
				<h2>children</h2>
				<ImagePixelReveal key={`children-${session}`} src={revealImage} className="image-preview-frame" replayOnHover loading="eager">
					<figure className="image-preview-content">
						<img className="image-preview-image" src={revealImage} width={720} height={480} alt="自定义内容中的山间风景" />
						<figcaption>自定义内容使用同一遮罩</figcaption>
					</figure>
				</ImagePixelReveal>
			</section>
		</div>
		<output id="image-reveal-errors">{errors.length > 0 ? `加载失败：${errors.join(", ")}` : ""}</output>
	</main>;
}

function ShadowForm() {
	const [cancelReset, setCancelReset] = useState(false);
	return <form id="shadow-checkbox-form" onReset={(event) => {
		if (cancelReset) event.preventDefault();
	}}>
		<Checkbox id="shadow-checkbox" name="shadow" defaultChecked aria-label="ShadowRoot 中的选择" />
		<button id="shadow-checkbox-reset" type="reset">重置 ShadowRoot 选择</button>
		<button id="cancel-shadow-checkbox-reset" type="button" onClick={() => setCancelReset(true)}>取消 ShadowRoot 重置</button>
	</form>;
}

function ShadowPreview() {
	const hostRef = useRef<HTMLDivElement>(null);
	useEffect(() => {
		const host = hostRef.current;
		if (!host) return;
		const shadow = host.shadowRoot ?? host.attachShadow({ mode: "open" });
		const style = document.createElement("style");
		style.textContent = checkboxCss;
		shadow.append(style);
		const container = document.createElement("div");
		shadow.append(container);
		const root = createRoot(container);
		root.render(<ShadowForm />);
		return () => {
			root.unmount();
			style.remove();
			container.remove();
		};
	}, []);
	return <div id="shadow-checkbox-host" ref={hostRef} />;
}

function App() {
	const [count, setCount] = useState(0);
	const [submitted, setSubmitted] = useState("");
	const [externalForm, setExternalForm] = useState("external-checkbox-form");
	const [cancelledChanges, setCancelledChanges] = useState<string[]>([]);
	const [lateFormVersion, setLateFormVersion] = useState<number | null>(null);
	const [lateCancelledMounted, setLateCancelledMounted] = useState(false);
	const [lateCancelledChanges, setLateCancelledChanges] = useState<string[]>([]);
	const [controlledChecked, setControlledChecked] = useState(true);
	const [controlledRequests, setControlledRequests] = useState<string[]>([]);
	const [searches, setSearches] = useState<string[]>([]);
	const [keys, setKeys] = useState<string[]>([]);
	return (
		<main>
			<h1>独立安装的 Violet UI</h1>
			<a href="/?preview=image-pixel-reveal">打开图片揭示独立消费页</a>
			<section aria-label="React 组件">
				<h2>React</h2>
				<Button id="react-button" variant="primary" onClick={() => setCount(count + 1)}>
					保存 {count}
				</Button>
				<TextField id="email" label="邮箱" description="用于发送更新" type="email" />
				<TextField id="invalid-email" label="错误状态" invalid errorMessage="请输入正确邮箱" />
			</section>
			<section aria-label="纯 HTML 样式">
				<h2>HTML</h2>
				<button id="html-button" type="button" className={buttonVariants({ variant: "primary" })}>
					保存
				</button>
				<label htmlFor="html-email" className="v-label">邮箱</label>
				<input id="html-email" type="email" className="v-input" />
			</section>
			<section className="preview-scope" aria-label="局部主题">
				<Button id="scoped-button" variant="primary">局部主题</Button>
			</section>
			<section aria-label="复选框表单">
				<h2>Checkbox</h2>
				<form id="checkbox-form" onSubmit={(event) => {
					event.preventDefault();
					setSubmitted(JSON.stringify(Array.from(new FormData(event.currentTarget).entries())));
				}}>
					<div className="checkbox-row">
						<Checkbox id="updates" name="updates" value="weekly" defaultChecked required variant="primary" />
						<Label htmlFor="updates">订阅每周更新</Label>
					</div>
					<div className="checkbox-row">
						<Checkbox id="all-items" defaultChecked="indeterminate" aria-label="选择全部" />
						<Checkbox id="disabled-checkbox" defaultChecked disabled aria-label="不可用选择" />
						<Checkbox id="invalid-checkbox" aria-invalid aria-label="无效选择" />
					</div>
					<Button id="checkbox-submit" type="submit">提交选择</Button>
					<Button id="checkbox-reset" type="reset">重置选择</Button>
				</form>
				<output id="checkbox-submitted">{submitted}</output>
				<form id="external-checkbox-form">
					<Button id="external-checkbox-reset" type="reset">重置外部选择</Button>
				</form>
				<form id="second-checkbox-form">
					<Button id="second-checkbox-reset" type="reset">重置第二表单</Button>
				</form>
				<Button id="reassign-checkbox" onClick={() => setExternalForm("second-checkbox-form")}>改变表单归属</Button>
				<Checkbox id="external-checkbox" form={externalForm} name="external" value="enabled" defaultChecked aria-label="表单外选择" />
				<form id="cancelled-checkbox-form" onReset={(event) => event.preventDefault()}>
					<Checkbox id="cancelled-checkbox" name="retained" aria-label="取消重置的选择" onCheckedChange={(next) => setCancelledChanges((changes) => [...changes, String(next)])} />
					<Button id="cancelled-checkbox-reset" type="reset">取消重置</Button>
				</form>
				<output id="cancelled-checkbox-changes">{JSON.stringify(cancelledChanges)}</output>
				<div className="checkbox-row">
					<Checkbox id="late-checkbox" form="late-checkbox-form" name="late" defaultChecked aria-label="稍后关联表单的选择" />
					<Button id="mount-late-checkbox-form" onClick={() => setLateFormVersion((version) => version === null ? 0 : version + 1)}>挂载或替换表单</Button>
				</div>
				{lateFormVersion !== null && <form key={lateFormVersion} id="late-checkbox-form">
					<Button id="late-checkbox-reset" type="reset">重置晚挂选择</Button>
				</form>}
				<div className="checkbox-row">
					<Checkbox id="late-cancelled-checkbox" form="late-cancelled-checkbox-form" name="late-retained" defaultChecked aria-label="稍后关联取消重置表单的选择" onCheckedChange={(next) => setLateCancelledChanges((changes) => [...changes, String(next)])} />
					<Button id="mount-late-cancelled-checkbox-form" onClick={() => setLateCancelledMounted(true)}>挂载取消重置表单</Button>
				</div>
				{lateCancelledMounted && <form id="late-cancelled-checkbox-form" onReset={(event) => event.preventDefault()}>
					<Button id="late-cancelled-checkbox-reset" type="reset">取消晚挂重置</Button>
				</form>}
				<output id="late-cancelled-checkbox-changes">{JSON.stringify(lateCancelledChanges)}</output>
				<form id="controlled-checkbox-form">
					<Checkbox id="controlled-checkbox" checked={controlledChecked} name="controlled" aria-label="由宿主持有的选择" onCheckedChange={(next) => setControlledRequests((requests) => [...requests, String(next)])} />
					<Button id="change-controlled-checkbox" onClick={() => setControlledChecked(false)}>更新受控值</Button>
					<Button id="controlled-checkbox-reset" type="reset">请求复位受控值</Button>
				</form>
				<output id="controlled-checkbox-requests">{JSON.stringify(controlledRequests)}</output>
				<ShadowPreview />
			</section>
			<section aria-label="搜索交互">
				<h2>SearchInput</h2>
				<SearchInput id="search-query" aria-label="搜索文章" defaultValue="violet" onKeyDown={(event) => setKeys((keys) => [...keys, event.key])} onSearch={(query) => setSearches((searches) => [...searches, query])} />
				<output id="search-keys">{JSON.stringify(keys)}</output>
				<output id="search-queries">{JSON.stringify(searches)}</output>
				<SearchInput id="readonly-query" aria-label="只读搜索" readOnly defaultValue="保留文本" />
				<SearchInput id="disabled-query" aria-label="禁用搜索" disabled defaultValue="保留文本" />
			</section>
		</main>
	);
}

const root = document.getElementById("root");
if (!root) throw new Error("Consumer root is missing.");
const preview = new URLSearchParams(window.location.search).get("preview");
createRoot(root).render(preview === "image-pixel-reveal" ? <ImagePixelRevealPreview /> : preview === "upload-tile" ? <UploadTilePreview /> : preview === "dropdown" ? <DropdownPreview /> : <App />);
