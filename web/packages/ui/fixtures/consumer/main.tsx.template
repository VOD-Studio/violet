							<MorphingPopoverTrigger>账户</MorphingPopoverTrigger>
						</div>
					</MorphingPopoverAnchor>
					<MorphingPopoverContent aria-label="胶囊面板"><input aria-label="胶囊面板输入" /></MorphingPopoverContent>
				</MorphingPopover>
				<HoverCard>
					<HoverCardTrigger asChild><a id="overlay-hover-trigger" href="#linjian">@林间</a></HoverCardTrigger>
					<HoverCardContent>林间的名片</HoverCardContent>
				</HoverCard>
				<Tooltip>
					<TooltipTrigger asChild><Button id="overlay-tooltip-trigger" variant="ghost" aria-label="加粗">B</Button></TooltipTrigger>
					<TooltipContent shortcut={["shift", "b"]}>加粗</TooltipContent>
				</Tooltip>
				<DropdownMenu onOpenChange={(open) => note(`menu:${open}`)}>
					<DropdownMenuTrigger asChild><Button id="overlay-menu-trigger" variant="outline">更多</Button></DropdownMenuTrigger>
					<DropdownMenuContent>
						<DropdownMenuItem onSelect={() => note("menu:edit")}>编辑</DropdownMenuItem>
						<DropdownMenuItem variant="destructive" reason="不可恢复" disabled>删除</DropdownMenuItem>
					</DropdownMenuContent>
				</DropdownMenu>
				<ContextMenu>
					<ContextMenuTrigger asChild><div id="overlay-context-trigger" className="display-field">右键这里</div></ContextMenuTrigger>
					<ContextMenuContent><ContextMenuItem onSelect={() => note("context:copy")}>复制</ContextMenuItem></ContextMenuContent>
				</ContextMenu>
			</section>
		</TooltipProvider>
		<output id="overlay-log">{log.join(",")}</output>
		<Toaster />
	</main>;
}

