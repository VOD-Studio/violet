				<Label htmlFor="consumer-input-name">显示名称</Label>
				<Input id="consumer-input-name" name="name" defaultValue="初始名称" clearable />
				<Label htmlFor="consumer-input-password">密码</Label>
				<Input id="consumer-input-password" name="password" type="password" defaultValue="violet-password" passwordToggle clearable />
				<Label htmlFor="consumer-input-readonly">只读字段</Label>
				<Input id="consumer-input-readonly" name="readonly" defaultValue="保留内容" readOnly clearable />
				<Label htmlFor="consumer-input-disabled">禁用字段</Label>
				<Input id="consumer-input-disabled" name="disabled" defaultValue="不会提交" disabled clearable />
				<div className="input-controls">
					<Button type="submit">提交 Input 表单</Button>
					<Button type="reset">重置 Input 表单</Button>
					<label><input type="checkbox" checked={cancelReset} onChange={(event) => setCancelReset(event.currentTarget.checked)} />取消表单重置</label>
				</div>
			</form>
			<Label htmlFor="consumer-input-external">表单外字段</Label>
			<Input id="consumer-input-external" form="input-form" name="external" defaultValue="外部初值" clearable />
			<output id="input-submitted">{submitted}</output>
		</section>
		<section aria-label="受控拒绝更新">
			<Label htmlFor="consumer-input-controlled">固定受控值</Label>
