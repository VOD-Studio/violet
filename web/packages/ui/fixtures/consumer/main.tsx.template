import { Button, Checkbox, DocumentScrollbar, Dropdown, DropdownContent, DropdownGroup, DropdownItem, DropdownTrigger, ImagePixelReveal, Input, Label, OverlayScroll, SearchInput, Segmented, UploadTile, type PixelRevealVariant } from "@violet/ui";
import { buttonVariants } from "@violet/ui/variants";
import checkboxCss from "@violet/ui/components/checkbox.css?raw";
import { useEffect, useRef, useState } from "react";
import { createRoot } from "react-dom/client";
import "./style.css";

function OverlayScrollPreview() {
	const [enabled, setEnabled] = useState(true);
	return <>
		{enabled && <DocumentScrollbar />}
		<main>
			<h1>OverlayScroll · 独立安装包</h1>
			<Button id="document-scrollbar-toggle" onClick={() => setEnabled((value) => !value)}>
				{enabled ? "恢复原生滚动条" : "启用覆盖式滚动条"}
			</Button>
			<p>页面继续由 window 滚动；下方视口独立支持横向和纵向拖拽。</p>
			<a href="#overlay-scroll-end">定位页尾</a>
			<OverlayScroll id="element-scroll" className="h-64">
				<div style={{ width: "140%", height: "40rem", padding: "1rem" }}>
					元素内的滚动内容
				</div>
			</OverlayScroll>
			<div style={{ height: "200vh" }} />
			<p id="overlay-scroll-end">文档滚动终点</p>
		</main>
	</>;
}

function DropdownPreview() {
	const [products, setProducts] = useState(false);
	const [resources, setResources] = useState(false);
	const [narrow, setNarrow] = useState(false);
	const [dark, setDark] = useState(document.documentElement.classList.contains("dark"));
	const toggleTheme = () => {
		document.documentElement.classList.toggle("dark", !dark);
		setDark(!dark);
	};
	return <main className="dropdown-page" data-narrow={narrow}>
		<h1>Dropdown · 独立安装包</h1>
		<p>悬停或 Tab 聚焦触发器展开面板；点击不开合，Escape 收起，触屏不展开。两个菜单互斥，组内切换立即展开。</p>
		<div className="image-reveal-controls">
			<Label htmlFor="dropdown-narrow"><Checkbox id="dropdown-narrow" checked={narrow} onCheckedChange={(checked) => setNarrow(checked === true)} />窄屏</Label>
			<Button id="dropdown-theme" onClick={toggleTheme}>{dark ? "切换浅色" : "切换深色"}</Button>
		</div>
		<nav className="dropdown-nav" aria-label="悬停菜单">
			<DropdownGroup>
				<Dropdown onOpenChange={setProducts}>
					<DropdownTrigger id="dropdown-products">产品</DropdownTrigger>
					<DropdownContent className="dropdown-panel" align="start">
						<DropdownItem asChild><a href="#components">组件</a></DropdownItem>
						<DropdownItem asChild><a href="#tokens">设计令牌</a></DropdownItem>
						<DropdownItem asChild><a href="#themes">主题</a></DropdownItem>
					</DropdownContent>
				</Dropdown>
				<Dropdown onOpenChange={setResources}>
					<DropdownTrigger asChild><a id="dropdown-resources" href="#resources">资源</a></DropdownTrigger>
					<DropdownContent className="dropdown-panel" align="start">
						<DropdownItem asChild><a href="#guides">指南</a></DropdownItem>
						<DropdownItem asChild><a href="#changelog">更新日志</a></DropdownItem>
						<DropdownItem onClick={toggleTheme}>{dark ? "切换浅色" : "切换深色"}</DropdownItem>
						<DropdownItem disabled>暂不可用</DropdownItem>
					</DropdownContent>
				</Dropdown>
			</DropdownGroup>
		</nav>
		<output id="dropdown-state" aria-live="polite">产品：{products ? "展开" : "收起"}；资源：{resources ? "展开" : "收起"}</output>
	</main>;
}

const viewSegments = [{ value: "grid", label: "网格" }, { value: "table", label: "表格" }];

function SegmentedPreview() {
	const [value, setValue] = useState("grid");
	const [expanded, setExpanded] = useState(true);
	const [narrow, setNarrow] = useState(false);
	const [dark, setDark] = useState(document.documentElement.classList.contains("dark"));
	const labelled = [{ value: "grid", label: "网格", icon: <span aria-hidden="true">▦</span> }, { value: "table", label: "表格", icon: <span aria-hidden="true">☰</span> }, { value: "list", label: "列表", icon: <span aria-hidden="true">≡</span> }];
	return <main className="segmented-page" data-narrow={narrow}>
		<h1>Segmented · 独立安装包</h1>
		<p>横向与竖向、三种变体；指示器随选中项平移，方向键只移动焦点。可切换收起选中项、主题与窄屏。</p>
		<div className="image-reveal-controls">
			<Label htmlFor="segmented-expand"><Checkbox id="segmented-expand" checked={expanded} onCheckedChange={(checked) => setExpanded(checked === true)} />收起选中项</Label>
			<Label htmlFor="segmented-narrow"><Checkbox id="segmented-narrow" checked={narrow} onCheckedChange={(checked) => setNarrow(checked === true)} />窄屏</Label>
			<Button id="segmented-theme" onClick={() => {
				document.documentElement.classList.toggle("dark", !dark);
				setDark(!dark);
			}}>{dark ? "切换浅色" : "切换深色"}</Button>
		</div>
		<div className="segmented-row">
			{(["soft", "ink", "line"] as const).map((variant) => <div key={variant} className="segmented-stack">
				<Segmented aria-label={`横向 ${variant}`} variant={variant} value={value} onValueChange={setValue} segments={viewSegments} />
				<Segmented aria-label={`竖向 ${variant}`} orientation="vertical" variant={variant} value={value} onValueChange={setValue} segments={viewSegments} />
			</div>)}
		</div>
		<Segmented aria-label="收起选中项" itemSize="6rem" expandSelected={expanded} value={value} onValueChange={setValue} segments={labelled} />
		<output id="segmented-state" aria-live="polite">选中：{value}</output>
	</main>;
}

function UploadTilePreview() {
	const [count, setCount] = useState(0);
	const [busy, setBusy] = useState(false);
	const [disabled, setDisabled] = useState(false);
	const [narrow, setNarrow] = useState(false);
	const [dark, setDark] = useState(document.documentElement.classList.contains("dark"));
	const ref = useRef<HTMLButtonElement>(null);
	return <main className="upload-tile-page" data-narrow={narrow}>
		<h1>UploadTile · 独立安装包</h1>
		<p>只记录激活次数，不执行文件选择或上传。Tab 聚焦后按 Enter 或 Space；忙碌或禁用时不可激活。</p>
		<div className="image-reveal-controls">
			<Label htmlFor="upload-tile-busy"><Checkbox id="upload-tile-busy" checked={busy} onCheckedChange={(checked) => setBusy(checked === true)} />忙碌</Label>
			<Label htmlFor="upload-tile-disabled"><Checkbox id="upload-tile-disabled" checked={disabled} onCheckedChange={(checked) => setDisabled(checked === true)} />禁用</Label>
			<Label htmlFor="upload-tile-narrow"><Checkbox id="upload-tile-narrow" checked={narrow} onCheckedChange={(checked) => setNarrow(checked === true)} />窄屏</Label>
			<Button id="upload-tile-theme" onClick={() => {
				document.documentElement.classList.toggle("dark", !dark);
				setDark(!dark);
			}}>{dark ? "切换浅色" : "切换深色"}</Button>
			<Button id="upload-tile-focus" onClick={() => ref.current?.focus()}>聚焦上传入口</Button>
		</div>
		<section className="upload-tile-grid" aria-label="上传入口状态">
			<UploadTile id="upload-tile-action" ref={ref} aria-label="添加图片" busy={busy} disabled={disabled} onClick={() => setCount((value) => value + 1)} />
			<UploadTile busy onClick={() => setCount((value) => value + 1)}>处理中</UploadTile>
			<UploadTile disabled onClick={() => setCount((value) => value + 1)}>不可用</UploadTile>
		</section>
		<output id="upload-tile-count" aria-live="polite">激活次数：{count}</output>
	</main>;
}

