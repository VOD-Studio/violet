				<output id="late-cancelled-checkbox-changes">{JSON.stringify(lateCancelledChanges)}</output>
				<form id="controlled-checkbox-form">
					<Checkbox id="controlled-checkbox" checked={controlledChecked} name="controlled" aria-label="由宿主持有的选择" onCheckedChange={(next) => setControlledRequests((requests) => [...requests, String(next)])} />
					<Button id="change-controlled-checkbox" onClick={() => setControlledChecked(false)}>更新受控值</Button>
					<Button id="controlled-checkbox-reset" type="reset">请求复位受控值</Button>
				</form>
				<output id="controlled-checkbox-requests">{JSON.stringify(controlledRequests)}</output>
				<ShadowPreview />
			</section>
			<section aria-label="搜索交互">
				<h2>SearchInput</h2>
				<SearchInput id="search-query" aria-label="搜索文章" defaultValue="violet" onKeyDown={(event) => setKeys((keys) => [...keys, event.key])} onSearch={(query) => setSearches((searches) => [...searches, query])} />
				<output id="search-keys">{JSON.stringify(keys)}</output>
				<output id="search-queries">{JSON.stringify(searches)}</output>
				<SearchInput id="readonly-query" aria-label="只读搜索" readOnly defaultValue="保留文本" />
				<SearchInput id="disabled-query" aria-label="禁用搜索" disabled defaultValue="保留文本" />
			</section>
		</main>
	);
}

const root = document.getElementById("root");
