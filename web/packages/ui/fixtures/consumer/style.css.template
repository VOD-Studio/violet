@import "tailwindcss";
@import "@violet/ui/styles.css";

body {
	margin: 0;
	background: var(--background);
	color: var(--foreground);
	font-family: system-ui, sans-serif;
}
main {
	max-width: 40rem;
	margin: 2rem auto;
	padding: 1.5rem;
}
section {
	display: grid;
	gap: 1rem;
	padding: 1.5rem 0;
}
.preview-scope {
	--radius: 0.25rem;
	--primary-base: oklch(0.5 0.12 160);
	--primary-base-hover: oklch(0.45 0.12 160);
	--primary-base-foreground: white;
}
.checkbox-row {
	display: flex;
	align-items: center;
	gap: 0.625rem;
	margin-bottom: 1rem;
}
.image-reveal-page {
	max-width: 64rem;
}
.image-reveal-controls {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.75rem;
}
.image-reveal-grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
	gap: 1.5rem;
}
.image-reveal-grid section {
	min-width: 0;
}
.image-preview-frame {
	width: 100%;
	height: 15rem;
	border-radius: 0.75rem;
}
.image-preview-image {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
}
.image-preview-content {
	position: relative;
	width: 100%;
	height: 100%;
	margin: 0;
}
.image-preview-content figcaption {
	position: absolute;
	inset: auto 0 0;
	padding: 0.75rem;
	background: rgb(0 0 0 / 65%);
	color: white;
}
.upload-tile-page[data-narrow="true"] {
	max-width: 20rem;
}
.upload-tile-grid {
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 0.75rem;
}
