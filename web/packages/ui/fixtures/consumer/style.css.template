@import "tailwindcss";
@import "@violet/ui/styles.css";

body {
	margin: 0;
	background: var(--background);
	color: var(--foreground);
	font-family: system-ui, sans-serif;
}
main {
	max-width: 40rem;
	margin: 2rem auto;
	padding: 1.5rem;
}
section {
	display: grid;
	gap: 1rem;
	padding: 1.5rem 0;
}
.preview-scope {
	--radius: 0.25rem;
	--primary-base: oklch(0.5 0.12 160);
	--primary-base-hover: oklch(0.45 0.12 160);
	--primary-base-foreground: white;
}
