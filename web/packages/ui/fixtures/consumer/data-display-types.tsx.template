const nodes: TreeNodeData[] = [
	{ value: "series", label: "系列", meta: 12, children: [{ value: "series/rust", label: "Rust 全栈笔记", lazy: true }] },
	{ value: "about", label: "关于", icon: null },
];
export const trees = <>
	<Tree
		aria-label="文档目录"
		nodes={nodes}
		icons
		defaultValue="about"
		onValueChange={(value) => { const current: string = value; void current; }}
		onExpandedChange={(expanded) => { const keys: string[] = expanded; void keys; }}
		loadChildren={async (node) => { const parent: TreeNodeData = node; return [{ value: `${parent.value}/1`, label: "第 1 章" }]; }}
		ref={createRef<HTMLDivElement>()}
	/>
	<LeafTree aria-label="文件" nodes={nodes} expanded={["series"]} />
</>;
// @ts-expect-error 当前项是字符串。
export const invalidTreeValue = <Tree nodes={nodes} value={1} />;
// @ts-expect-error role 由组件持有。
export const invalidTreeRole = <LeafTree nodes={nodes} role="listbox" />;

export const pagers = <>
	<Pagination page={2} totalPages={9} onPageChange={(page) => { const next: number = page; void next; }} />
	<LeafPagination page={1} totalPages={1} onPageChange={() => {}} aria-label="文章分页" />
</>;
