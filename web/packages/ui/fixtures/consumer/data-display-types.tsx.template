interface Article {
	id: string;
	title: string;
	views: number;
}
const columns: DataTableColumn<Article>[] = [
	{ key: "title", header: "标题", accessorKey: "title", sortable: true, ellipsis: true, width: "320px" },
	{ key: "views", header: "浏览", accessorKey: "views", align: "right", exportValue: (row) => row.views },
	{ key: "actions", header: "操作", cell: (row) => row.id, sticky: "right", stopClickPropagation: true },
];
const tableProps: DataTableProps<Article> = {
	columns,
	data: [{ id: "1", title: "独库公路", views: 12 }],
	keyExtractor: (row) => row.id,
	pagination: { page: 1, pageSize: 10, total: 25, onChange: (page, pageSize) => { void [page, pageSize]; } },
	sort: { key: "title", order: "asc" } satisfies DataTableSort,
	onSortChange: (sort) => { const order: "asc" | "desc" = sort.order; void order; },
	selectable: true,
	onSelectionChange: (ids) => { const selected: Set<string> = ids; void selected; },
	bulkActions: <button type="button">发布</button>,
	onSelectAll: () => {},
	totalSelectable: 25,
	expandable: true,
	renderExpandedRow: (row) => row.title,
	storageKey: "articles",
	filtered: false,
	density: "compact",
	caption: "文章",
	emptyAction: <button type="button">写文章</button>,
	filteredTitle: "没有匹配的结果",
	filteredAction: <button type="button">清除筛选</button>,
	errorTitle: "没能读取文章列表",
	error: new Error("502"),
	onRetry: () => {},
};
export const dataTables = <>
	<DataTable {...tableProps} />
	<LeafDataTable {...tableProps} loading />
</>;
exportToCsv("articles", columns, tableProps.data);
// @ts-expect-error accessorKey 必须是行数据的键。
export const invalidColumn: DataTableColumn<Article> = { key: "missing", header: "缺失", accessorKey: "nope" };
// @ts-expect-error 排序方向只有升序与降序。
export const invalidSort: DataTableSort = { key: "title", order: "up" };
// @ts-expect-error 行密度只有舒适与紧凑。
export const invalidDensity = <DataTable {...tableProps} density="tight" />;

export const primitives = <Table>
	<TableHeader><TableRow><TableHead scope="col">标题</TableHead></TableRow></TableHeader>
