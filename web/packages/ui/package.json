{
	"name": "@violet/ui",
	"version": "0.1.0",
	"description": "React 19 + Tailwind CSS v4 component library with Violet semantic theme tokens",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": "./src/index.ts",
		"./styles.css": "./src/styles.css"
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json && node build-styles.mjs",
		"prepack": "pnpm run build"
	},
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./styles.css": "./dist/styles.css"
		}
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"cn": "^0.4.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.21.0",
		"motion": "^12.42.2",
		"radix-ui": "^1.6.0",
		"recharts": "2.15.4",
		"sonner": "^2.0.7",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.0"
	}
}
