{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"types": []
	},
	"include": ["src"],
	"exclude": [
		"src/**/__tests__/**",
		"src/**/*.test.*",
		"src/**/*.spec.*",
		"src/**/*.stories.*",
		"tests",
		"fixtures",
		"dist"
	]
}
