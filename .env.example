# 本地开发环境配置
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 根据需要修改配置
#   3. 启动服务: make dev
#
# 配置优先级: 环境变量 > config.yaml > 默认值

# ── 运行环境 ────────────────────────────────
ENVIRONMENT=development

# ── 服务配置 ────────────────────────────────
PORT=9090
FRONTEND_URL=http://localhost:5173
UPLOAD_PATH_PREFIX=/uploads/
UPLOAD_DIR=uploads

# ── 数据库 ──────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=blog
DATABASE_USER=xunrua
# 本地开发自定义一个强密码；切勿提交真实凭据
DATABASE_PASSWORD=changeme-strong-password
DATABASE_SSLMODE=disable

# ── Redis ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── 邮件服务 (Resend) ────────────────────────
# 开发环境可选，不配置则邮件功能不可用
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ── B站表情种子数据 ──────────────────────────
# 可选配置，用于初始化表情数据
# 登录 B站后，从浏览器 Network → 任一请求 → Request Headers → Cookie 复制完整字符串
BILIBILI_COOKIES=

# ── mimo-music 音乐解析服务 ────────────────────
# 自托管网易云解析服务地址，默认与 docker-compose 端口映射对齐
MIMO_MUSIC_URL=http://localhost:3721

# ── 超级管理员 ────────────────────────────────
# 开发环境可以启用，方便测试
SUPERADMIN_ENABLED=false
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
