# 本地开发环境配置
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 根据需要修改配置
#   3. 启动服务: make dev
#
# 配置优先级: 环境变量 > config.yaml > 默认值

# ── 运行环境 ────────────────────────────────
ENVIRONMENT=development

# ── 服务配置 ────────────────────────────────
PORT=9090
FRONTEND_URL=http://localhost:5173
UPLOAD_PATH_PREFIX=/uploads/
UPLOAD_DIR=uploads

# ── 数据库 ──────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=blog
DATABASE_USER=xunrua
# 本地开发自定义一个强密码；切勿提交真实凭据
DATABASE_PASSWORD=changeme-strong-password
DATABASE_SSLMODE=disable

# ── Redis ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── 邮件服务 (Resend) ────────────────────────
# 开发环境可选，不配置则邮件功能不可用
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ── B站表情种子数据 ──────────────────────────
# 可选配置，用于初始化表情数据
# 登录 B站后，从浏览器 Network → 任一请求 → Request Headers → Cookie 复制完整字符串
BILIBILI_COOKIES=

# ── 音乐解析服务（独立仓库 VOD-Studio/kite） ────────────────────
# 自托管网易云解析服务地址，本地开发需手动启动 kite 服务（docker-compose 已移除该服务）
KITE_URL=http://localhost:3721

# ── 超级管理员 ────────────────────────────────
# 开发环境可以启用，方便测试
SUPERADMIN_ENABLED=false
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

# ── 代码运行器（可运行代码块沙箱执行）──────────────
# 启用前确认 api 容器已挂载 docker.sock，且 yggdrasil-runner-* 镜像已 load
# 架构决策见 docs/adr/0006-code-runner-architecture.md
CODE_RUNNER_ENABLED=true
CODE_RUNNER_MAX_CPU_CORES=2.0
CODE_RUNNER_MAX_MEMORY_MB=1024
CODE_RUNNER_MAX_TIMEOUT_SECS=30
CODE_RUNNER_MAX_OUTPUT_BYTES=1048576
CODE_RUNNER_MAX_SOURCE_BYTES=65536
CODE_RUNNER_ALLOW_NETWORK=false
CODE_RUNNER_MAX_CONCURRENT=4
CODE_RUNNER_QUEUE_TIMEOUT_SECS=30
CODE_RUNNER_TASK_TTL_SECS=300
# podman 改 /run/podman/podman.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock
# 语言白名单（逗号分隔 canonical key），留空=全部；如 python,node
CODE_RUNNER_LANGUAGES=
