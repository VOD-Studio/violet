# violet 环境变量（唯一 env 文件，不入库）
#
# 职责划分（Grafana 模式）：
#   - 本文件：密钥 + 环境差异值，唯一敏感来源
#   - api/config.yaml（入库）：全部配置键 + 非敏感默认值 + 注释，配置的权威文档
#   - 优先级：进程环境变量 > 本文件 > config.yaml > 代码默认值
#
# 使用：
#   1. cp .env.example .env
#   2. 填写下方密钥（至少 DATABASE_PASSWORD）
#   3. make dev
#
# 本文件服务四个角色，按区分组：
#   [docker]  compose 插值（postgres/redis 容器初始化）
#   [api]     Go 服务（config.Load 经 godotenv 加载本文件）
#   [工具]    omp 等本地工具

# ── [docker+api] 数据库 ─────────────────────
# 同一组值：compose 用它初始化 postgres 容器，api 用它连接
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=blog
DATABASE_USER=blog
# 本地开发自定义一个强密码；切勿提交真实凭据
DATABASE_PASSWORD=changeme-strong-password
DATABASE_SSLMODE=disable

# ── [docker+api] Redis ──────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── [api] 运行环境 ──────────────────────────
ENVIRONMENT=development
PORT=9090

# ── [生产必填] CORS 允许来源 ─────────────────
# 仅生产部署需要(docker-compose.prod.yml 强制检查);本地开发无需设置(config.yaml 默认 localhost)
# 逗号分隔,如: CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# CORS_ALLOWED_ORIGINS=

# ── [api] OAuth（可选）───────────────────────
# GOOGLE_CLIENT_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── [api] 邮件服务 Resend（可选）─────────────
# 留空时开发模式打印验证码到日志
# RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ── [api] B 站表情种子数据（可选）─────────────
# 登录 B 站后，浏览器 Network → 任一请求 → Request Headers → Cookie 复制完整字符串
# BILIBILI_COOKIES=

# ── [api] 音乐解析服务 kite（可选）────────────
KITE_URL=http://localhost:3721

# ── [api] 超级管理员（可选）───────────────────
SUPERADMIN_ENABLED=false
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
# SUPERADMIN_PASSWORD=

# ── [api] 代码运行器（可选，ADR-0006）─────────
# 启用前确认已挂载 docker.sock 且 yggdrasil-runner-* 镜像已 load
CODE_RUNNER_ENABLED=true
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# 语言白名单（逗号分隔 canonical key），留空=全部；如 python,node
# CODE_RUNNER_LANGUAGES=

# ── [工具] 博客 MCP 服务器 PAT ───────────────
# 在博客后台生成后填入；omp 的 .omp/mcp.json 通过 ${VIOLET_MCP_PAT} 引用
VIOLET_MCP_PAT=
