# 容器内开发环境覆盖配置（Docker-in-Docker）
#
# 适用场景：在 Docker 容器内开发（如 coder / code-server / OMP），
# 数据库容器由 docker compose 起在宿主机上，经 host.docker.internal 访问。
#
# 用法：
#   1. cp .env.docker-dev.example .env.docker-dev
#   2. make dev-dind
#
# 本文件只列出与根 .env 的差异项（host 覆盖）。
# 密码等其余配置仍从根 .env 读取（config.Load 经 godotenv 加载）。
# dev-dind.sh 启动时 source 本文件，以进程环境变量覆盖 .env（优先级最高）。
#
# host.docker.internal 在 Docker Desktop（macOS/Windows/Linux）下指向宿主机 loopback；
# Linux 原生 Docker 需在容器加 --add-host=host.docker.internal:host-gateway。

# 覆盖根 .env 的 localhost：容器内无法经 localhost 访问宿主机上的数据库容器
DATABASE_HOST=host.docker.internal
REDIS_HOST=host.docker.internal
